{
  "name": "competitive-lab-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader native",
    "test": "vitest --config vitest.config.ts --configLoader runner --pool=threads --no-file-parallelism",
    "test:run": "vitest run --config vitest.config.ts --configLoader runner --pool=threads --no-file-parallelism",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "html-to-image": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
