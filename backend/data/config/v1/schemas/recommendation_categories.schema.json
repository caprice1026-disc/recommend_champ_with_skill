{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "displayOrder", "primaryCount", "alternativeCount"], "properties": {"id": {"enum": ["ready_now", "growth_candidate", "aspirational"]}, "name": {"type": "string"}, "displayOrder": {"type": "integer", "minimum": 1}, "primaryCount": {"const": 1}, "alternativeCount": {"type": "integer", "minimum": 0}}}}
  }
